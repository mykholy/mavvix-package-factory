{
  "name": "mykholy/laravel-failurelab",
  "description": "Deterministic failure-boundary and replay testing for Laravel services.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "testing",
    "fault-injection",
    "idempotency",
    "recovery",
    "replay"
  ],
  "require": {
    "php": "^8.3",
    "illuminate/contracts": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0"
  },
  "require-dev": {
    "laravel/framework": "^12.0 || ^13.0",
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
    "laravel/pint": "^1.24"
  },
  "autoload": {
    "psr-4": {
      "Mykholy\\FailureLab\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mykholy\\FailureLab\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Mykholy\\FailureLab\\FailureLabServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit --no-coverage",
    "format": "@php vendor/bin/pint",
    "format:check": "@php vendor/bin/pint --test"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
